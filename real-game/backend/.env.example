# Booth relay — copy this file to `.env` in real-game/backend/ and fill in.
#
# Without BOTH values the relay disables itself and the game runs exactly as
# it did before: local leaderboard, local result screen, no push. That is the
# intended fallback, not a failure.
#
# RELAY_API_KEY must match RELAY_API_KEY in the deployed booth-relay/api/config.php.

RELAY_BASE_URL=https://antiquewhite-jay-310571.hostingersite.com/booth-api
RELAY_API_KEY=REPLACE_ME_WITH_THE_SAME_KEY_AS_API_CONFIG_PHP
