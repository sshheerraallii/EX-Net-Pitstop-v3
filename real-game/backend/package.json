{
  "name": "extreme-networks-game-server",
  "version": "1.0.0",
  "description": "Mock SNMP server for Extreme Networks Pitstop Challenge game",
  "main": "server2.js",
  "private": true,
  "scripts": {
    "start": "node server2.js",
    "dev": "nodemon server2.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "snmp",
    "game",
    "extreme-networks",
    "pitstop",
    "express",
    "api"
  ],
  "author": "Extreme Networks",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "net-snmp": "^3.26.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/extreme-networks/pitstop-challenge-server"
  },
  "nodemonConfig": {
    "watch": [
      "server2.js",
      "db/",
      "routes/",
      "middleware/",
      "config/"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "logs/",
      "*.test.js"
    ],
    "delay": "1000"
  }
}